{
  "name": "chessdoctor",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "preview": "vite preview",
    "book": "node scripts/build-book.mjs",
    "engine": "node scripts/copy-engine.mjs",
    "shots": "node scripts/screenshots.mjs",
    "predev": "node scripts/copy-engine.mjs",
    "prebuild": "node scripts/copy-engine.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name chessdoctor --branch main --commit-dirty=false"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "playwright": "^1.65.1",
    "playwright-core": "^1.65.1",
    "stockfish": "^19.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  }
}
